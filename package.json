{
  "name": "scratchpad",
  "version": "1.3.1",
  "private": true,
  "description": "Drop-down scratchpad overlay extension for GNOME Shell 46-51",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test build/test/test/*.test.js test/*.test.mjs",
    "test:session": "python3 scripts/test-session.py",
    "build": "tsc && bash scripts/assemble.sh",
    "pack": "npm run build && bash scripts/pack.sh",
    "check:package": "node scripts/check-package.mjs",
    "check:release": "npm run check && npm test && npm run pack && npm run check:package"
  },
  "devDependencies": {
    "@girs/gjs": "5.6.0",
    "@girs/gnome-shell": "51.0.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exclude-barrier/scratchpad.git"
  }
}
